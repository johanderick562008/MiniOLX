# Copy this file to .env and fill in real values. Never commit .env.

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=mini_olx_user
DB_PASSWORD=
DB_NAME=mini_olx
# true prints every SQL query to the terminal
DB_ECHO=false

# ---- Security ----
# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# How long a login lasts, in days
SESSION_DAYS=7
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# ---- Look of the site ----
# premium (Stitch design) or classic (the original design)
THEME=premium

# ---- UPI fallback ----
# Sellers set their own UPI ID in Payment settings. These are only used for
# orders placed before that feature existed.
UPI_ID=example@upi
UPI_NAME=Mini OLX

# ---- Razorpay TEST mode (optional) ----
# Leave empty to offer only the UPI QR.
# Dashboard -> Test Mode -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in the Dashboard
RAZORPAY_WEBHOOK_SECRET=

# ---- Sign in with Google (optional) ----
# Leave empty to hide the Google button.
# Google Cloud Console -> Google Auth Platform -> Clients -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" of that client EXACTLY
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback